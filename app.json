{
  "expo": {
    "name": "Meteo Analaze ☁️",
    "slug": "meteo-analaze",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0d6efd"
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow Meteo Analaze to access your location for live weather updates and precise local alerts."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#0d6efd"
        }
      ],
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "MeteoWidget",
              "label": "Meteo Weather Brief",
              "minWidth": "180dp",
              "minHeight": "110dp",
              "targetCellWidth": 3,
              "targetCellHeight": 2,
              "description": "Displays live temperature, weather status, and location on your home screen."
            }
          ]
        }
      ]
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.mazimum.climateanalyzer"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#0d6efd"
      },
      "package": "com.mazimum.climateanalyzer",
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "POST_NOTIFICATIONS",
        "RECEIVE_BOOT_COMPLETED",
        "WAKE_LOCK",
        "SCHEDULE_EXACT_ALARM"
      ]
    },
    "web": {
      "favicon": "./assets/icon.png",
      "output": "single"
    },
    "sdkVersion": "51.0.0",
    "extra": {
      "eas": {
        "projectId": "02dc6756-6a39-465e-84ae-54452b4a360e"
      }
    },
    "owner": "mazi3",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/02dc6756-6a39-465e-84ae-54452b4a360e",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    }
  }
}